{
  "name": "batchin-public-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BatchIn Developer Resources & SDK Monorepo",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ts": "npm run test --workspaces --if-present",
    "test:py": "pytest",
    "test": "npm run test:ts && npm run test:py",
    "cli": "node packages/cli-ts/src/cli.js",
    "compliance": "python3 scripts/scan_compliance.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
