{
  "name": "@batchin/vaas",
  "version": "0.1.0",
  "private": false,
  "description": "BatchIn VaaS TypeScript SDK for cryptographic receipt and evidence verification APIs.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://batchin.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aw3703/batchin-public.git",
    "directory": "packages/vaas-sdk-ts"
  },
  "bugs": {
    "url": "https://github.com/aw3703/batchin-public/issues"
  },
  "keywords": [
    "batchin",
    "vaas",
    "verifiable-ai",
    "ai",
    "audit",
    "merkle-proof",
    "cryptographic-receipt"
  ],
  "exports": {
    ".": {
      "types": "./src/client.d.ts",
      "import": "./src/client.js"
    }
  },
  "types": "./src/client.d.ts",
  "bin": {
    "vaas-verify": "./bin/vaas-verify.mjs",
    "batchin-vaas": "./bin/vaas-verify.mjs"
  },
  "files": [
    "src/client.js",
    "src/client.d.ts",
    "bin/vaas-verify.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.copyFileSync('dist/client.js','src/client.js');fs.copyFileSync('dist/client.d.ts','src/client.d.ts');\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
